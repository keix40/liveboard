# ─── Shared ───────────────────────────────────────────────────────────────
# HS256 secret shared by the web app (signs room tokens) and the sync server
# (verifies them). Generate with:  openssl rand -base64 48
LIVEBOARD_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ─── apps/server (Render) ─────────────────────────────────────────────────
PORT=1234
# Comma-separated list of allowed browser origins for the WebSocket upgrade.
# Empty = allow any origin (dev only).
ALLOWED_ORIGINS=http://localhost:3000
# memory | postgres
PERSISTENCE=memory
# Required when PERSISTENCE=postgres
DATABASE_URL=postgres://liveboard:liveboard@localhost:5432/liveboard
# Optional: enables cross-instance fan-out via Redis pub/sub
REDIS_URL=
# Compact a room's update log into a snapshot after this many updates
COMPACT_EVERY_N_UPDATES=500
# Per-connection rate limit (token bucket)
RATE_LIMIT_MSGS_PER_SEC=60
RATE_LIMIT_BURST=200
MAX_MESSAGE_BYTES=1048576
MAX_CONNECTIONS_PER_ROOM=50
LOG_LEVEL=info

# ─── apps/web (Vercel) ────────────────────────────────────────────────────
# Public URL of the sync server (ws:// locally, wss:// in production)
NEXT_PUBLIC_WS_URL=ws://localhost:1234
